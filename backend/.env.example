# Copia este archivo a .env y ajusta los valores (el backend lee variables de entorno).
DATABASE_URL=sqlite:///./colsong.db
# Producción (Neon): usa la cadena de conexión directa, sin "-pooler" en el host
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=10080
# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
# Carga datos de demostración (artista, 3 venues y oportunidades) si la base está vacía
SEED_DEMO=true
